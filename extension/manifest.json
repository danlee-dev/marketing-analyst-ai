{
  "manifest_version": 3,
  "name": "레퍼런스 보관함",
  "short_name": "보관함",
  "version": "1.0.0",
  "description": "인스타·YouTube·X·TikTok·웹 레퍼런스를 한 번에 보관함으로 저장하고, 컬렉션은 통째로 가져와요.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "레퍼런스 보관함에 저장",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting", "contextMenus", "alarms"],
  "host_permissions": ["https://marketing-analyst-ai.vercel.app/*", "http://localhost:3017/*"],
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content/instagram.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://marketing-analyst-ai.vercel.app/*", "http://localhost:3017/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "save-page": {
      "suggested_key": { "default": "Alt+Shift+S", "mac": "Alt+Shift+S" },
      "description": "지금 보는 페이지를 마지막 저장 위치에 저장"
    }
  },
  "web_accessible_resources": [{ "resources": ["fonts/PretendardVariable.woff2", "icons/logo.svg"], "matches": ["https://www.instagram.com/*"] }]
}
